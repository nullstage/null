# 저장소에는 LF로 저장하고, 체크아웃 시 OS 기본을 따른다.
* text=auto eol=lf

# 바이너리 에셋은 변환하지 않는다.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.ogg binary
*.wav binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# 자동 생성 파일은 diff와 언어 통계에서 제외한다.
package-lock.json linguist-generated=true -diff
